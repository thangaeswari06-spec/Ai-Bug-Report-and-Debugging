# ---- Backend (export these, or use a tool like python-dotenv) ----------------
# Long random string used to sign login tokens. If unset, one is generated
# into data/.secret_key for local development.
SECRET_KEY=

# "Continue with Google": OAuth *Web* client id from Google Cloud Console.
# Add http://localhost:5173 under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=636041592988-j9nnbqu7tq6iie847thmfvui3o8hgja2.apps.googleusercontent.com

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM backend for fix generation: mock | ollama | api
LLM_BACKEND=mock